{
  "_about": "Node refs (issue #137): texts that app/nodes.py parse_ref and app/static/nodes.js Ref.parse must treat the same way. accept: the text and what it parses to (kind session|task, handle, rest). refuse: texts both must refuse. The Python side is stricter for the tmux part (a ccboard session name of three parts joined by --); cases where only that differs are not listed here.",
  "accept": [
    {"text": "box/shop--api--t-fix", "kind": "session", "handle": "box", "rest": "shop--api--t-fix"},
    {"text": "n2/p--r--s1", "kind": "session", "handle": "n2", "rest": "p--r--s1"},
    {"text": "node-a/Shop_1--api-2--S-3", "kind": "session", "handle": "node-a", "rest": "Shop_1--api-2--S-3"},
    {"text": "a/p--r--s", "kind": "session", "handle": "a", "rest": "p--r--s"},
    {"text": "0123456789012345678901234567890/p--r--s", "kind": "session", "handle": "0123456789012345678901234567890", "rest": "p--r--s"},
    {"text": "box:42", "kind": "task", "handle": "box", "rest": "42"},
    {"text": "node-a:7", "kind": "task", "handle": "node-a", "rest": "7"},
    {"text": "x:123456789012", "kind": "task", "handle": "x", "rest": "123456789012"}
  ],
  "refuse": [
    "box/../x",
    "box/a/b",
    "box/p--r--s/x",
    "Box/p--r--s",
    "BOX:1",
    "box:abc",
    "box:1a",
    "box:",
    "box:-1",
    "box:1.5",
    "box:1234567890123",
    "box:1:2",
    "box/",
    "/p--r--s",
    ":42",
    "/",
    ":",
    "",
    "local/p--r--s",
    "local:3",
    "01234567890123456789012345678901/p--r--s",
    "01234567890123456789012345678901:1",
    "-box/p--r--s",
    "bo_x/p--r--s",
    "bo.x/p--r--s",
    "box/p--r s--x",
    "box/p--r--s ",
    " box/p--r--s",
    "box/p--r--s\n",
    "box:42\n",
    "box\\p--r--s",
    "box//p--r--s",
    "box/%2e%2e",
    "http://box/p--r--s"
  ]
