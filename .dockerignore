# Build context for the ccboard image. The Dockerfile copies only app/, bin/, scripts/, tmux.conf and requirements.txt;
# this keeps everything else (and local caches) out of the context and out of those directories.
.git
.venv
tests
.gstack
.claude
.pytest_cache
__pycache__
**/__pycache__
*.pyc
*.tar.gz
ccboard.tar.gz
deploy
.github
# dev-only helpers: the image syncs scripts/ into the host's data dir, keep that directory to what the host runs
scripts/deploy.sh
scripts/package.sh
