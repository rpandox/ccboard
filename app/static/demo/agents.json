  "codex": {
   "name": "codex",
   "label": "Codex",
   "glyph": "◇",
   "installed": true,
   "version": "0.160.1",
   "auth": {
    "installed": true,
    "version": "0.160.1",
    "loggedIn": true,
    "authMethod": "chatgpt"
   },
   "hooks": {
    "installed": true,
    "trust": "review"
   },
   "options": [
    {
     "key": "launcher",
     "label": "Start",
     "kind": "select",
     "choices": [
      "new",
      "resume",
      "continue",
      "fork"
     ],
     "default": "new",
     "help": "new: a fresh session. resume: an earlier one by id or name (blank = Codex's picker). continue: the most recent in this folder (resume --last). fork: a copy of an earlier one (codex fork).",
     "group": "basic",
     "danger": false,
     "when": null
    },
    {
     "key": "resume_id",
     "label": "Session to resume or fork",
     "kind": "text",
     "choices": null,
     "default": null,
     "help": "An id (UUID) or the name Codex shows; blank opens Codex's picker.",
     "group": "basic",
     "danger": false,
     "when": {
      "launcher": [
       "resume",
       "fork"
      ]
     }
    },
    {
     "key": "name",
     "label": "Session name",
     "kind": "text",
     "choices": null,
     "default": null,
     "help": "The board's own label (and the tmux session name). Codex has no --name: it is not passed on.",
     "group": "basic",
     "danger": false,
     "when": null
    },
    {
     "key": "model",
     "label": "Model",
     "kind": "combo",
     "choices": [
      "gpt-6.1-sol",
      "gpt-6-astra",
      "gpt-6-sol",
      "gpt-6-luna",
      "gpt-5.6-sol"
     ],
     "default": null,
     "help": "-m. A slug from `codex debug models` (cached for an hour) or any model id; empty = Codex's own default.",
     "group": "basic",
     "danger": false,
     "when": null
    },
    {
     "key": "reasoning_effort",
     "label": "Reasoning",
     "kind": "select",
     "choices": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max",
      "ultra"
     ],
     "default": null,
     "help": "-c model_reasoning_effort=...; the levels a model accepts come from the catalogue (reasoning_by_model). Sent as `reasoning` or `reasoning_effort`.",
     "group": "basic",
     "danger": false,
     "when": null
    },
    {
     "key": "mode",
     "label": "Mode",
     "kind": "select",
     "choices": [
      "default",
      "auto",
      "read-only",
      "bypass",
      "custom"
     ],
     "default": "default",
     "help": "default: -s workspace-write -a on-request. auto: automatic approval review. read-only: -s read-only. bypass: no approvals and no sandbox (needs the acknowledgement, never for tasks). custom: choose the sandbox and approval below.",
     "group": "basic",
     "danger": false,
     "when": null
    },
    {
     "key": "sandbox",
     "label": "Sandbox",
     "kind": "select",
     "choices": [
      "read-only",
      "workspace-write",
      "danger-full-access"
     ],
     "default": null,
     "help": "-s. danger-full-access skips the sandbox like bypass: it needs the bypass acknowledgement and is interactive only.",
     "group": "basic",
     "danger": false,
     "when": {
      "mode": [
       "custom"
      ]
     }
    },
    {
     "key": "approval",
     "label": "Approval policy",
     "kind": "select",
     "choices": [
      "on-request",
      "never"
     ],
     "default": null,
     "help": "-a. on-request or never; untrusted is retired and on-failure deprecated (offered only where this Codex still lists them).",
     "group": "basic",
     "danger": false,
     "when": {
      "mode": [
       "custom"
      ]
     }
    },
    {
     "key": "prompt",
     "label": "First prompt",
     "kind": "textarea",
     "choices": null,
     "default": null,
     "help": "Typed as the first message of a new session (8000 characters at most).",
     "group": "basic",
     "danger": false,
     "when": {
      "launcher": [
       "new"
      ]
     }
    },
    {
     "key": "search",
     "label": "Live web search",
     "kind": "bool",
     "choices": null,
     "default": false,
     "help": "--search.",
     "group": "advanced",
     "danger": false,
     "when": null
    },
    {
     "key": "bypass",
     "label": "Skip approvals and the sandbox",
     "kind": "bool",
     "choices": null,
     "default": false,
     "help": "--dangerously-bypass-approvals-and-sandbox. Needs an explicit acknowledgement; never offered for tasks, dispatch or scheduled runs, and never stored for resume.",
     "group": "advanced",
     "danger": true,
     "when": null
    },
    {
     "key": "permission_mode",
     "label": "Permission mode (Claude's words)",
     "kind": "select",
     "choices": [
      "default",
      "acceptEdits",
      "plan",
      "auto",
      "dontAsk",
      "bypassPermissions"
     ],
     "default": null,
     "help": "The same choice as Mode in Claude's words: default and acceptEdits: -s workspace-write -a on-request. plan: -s read-only. dontAsk: -a never. auto: automatic approval review. bypassPermissions needs the bypass acknowledgement, never for tasks. Mode wins when both are sent.",
     "group": "advanced",
     "danger": false,
     "when": null
    },
    {
     "key": "add_dirs",
     "label": "Extra directories",
     "kind": "dirs",
     "choices": null,
     "default": null,
     "help": "--add-dir: sibling repos (project/repo) the session may write.",
     "group": "advanced",
     "danger": false,
     "when": null
    },
    {
     "key": "worktree",
     "label": "Start in a new git worktree",
     "kind": "bool",
     "choices": null,
     "default": false,
     "help": "ccboard runs `git worktree add -b worktree-<slug> .ccboard/worktrees/<slug>` and starts Codex in it; Codex has no native worktree flag here.",
     "group": "advanced",
     "danger": false,
     "when": {
      "launcher": [
       "new"
      ]
     }
    },
    {
     "key": "worktree_name",
     "label": "Worktree name",
     "kind": "text",
     "choices": null,
     "default": null,
     "help": "Letters, digits, '.', '_' and '-'. Blank: the session name.",
     "group": "advanced",
     "danger": false,
     "when": {
      "worktree": true
     }
    },
    {
     "key": "config",
     "label": "Config overrides",
     "kind": "textarea",
     "choices": null,
     "default": null,
     "help": "-c: one key=value per line (key: letters, digits, '_' and '.'; 20 lines at most). Keys the launcher owns (model, sandbox, approval, profile, hooks, MCP servers, providers) are refused.",
     "group": "advanced",
     "danger": false,
