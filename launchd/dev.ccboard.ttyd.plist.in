<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ccboard terminal (ttyd on loopback, attaches to ccboard tmux sessions). -W writable, -O origin must match Host, -a passes ?arg= to the wrapper only. Rendered by scripts/launchd_render.py; the counterpart of systemd/ccboard-ttyd.service.in, which differs only in the interface name (lo there, lo0 here). -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.ccboard.ttyd</string>
	<key>ProgramArguments</key>
	<array>
		<string>__TTYD_BIN__</string>
		<string>-i</string>
		<string>__TTYD_IFACE__</string>
		<string>-p</string>
		<string>__TTYD_PORT__</string>
		<string>-W</string>
		<string>-O</string>
		<string>-a</string>
		<string>-t</string>
		<string>titleFixed=ccboard</string>
		<string>-t</string>
		<string>disableLeaveAlert=true</string>
		<string>__APP_BIN__/ccboard-attach</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>PATH</key>
		<string>__PATH__</string>
		<key>SHELL</key>
		<string>__SHELL__</string>
		<key>TMUX_TMPDIR</key>
		<string>__TMUX_TMPDIR__</string>
		<key>CCBOARD_TMUX_SOCKET</key>
		<string>__TMUX_SOCKET__</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/ttyd.log</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/ttyd.log</string>
</dict>
</plist>
