#!/bin/sh
# ccboard: the only command ttyd runs. Attaches a browser to ONE tmux session by exact name.
# Validates the name so URL args can never become extra tmux commands.
set -u
fail() { printf 'ccboard: %s\n' "$1"; sleep 2; exit 1; }
[ "$#" -eq 1 ] || fail "usage: ccboard-attach <session>"
name=$1
[ -n "$name" ] || fail "empty session name"
case "$name" in *[!A-Za-z0-9_-]*) fail "invalid session name";; esac
[ "${#name}" -le 200 ] || fail "session name too long"
case "$name" in
  _ccboard-login) ;;
  _ccboard*) fail "internal session";;
esac
exec tmux -N -L "${CCBOARD_TMUX_SOCKET:-ccboard}" attach-session -t "=$name"
