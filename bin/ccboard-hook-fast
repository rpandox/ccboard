#!/bin/sh
# Claude Code hook -> ccboard, for SessionEnd. The same POST as ccboard-hook, registered WITHOUT async and with a short cap (2 s): the
# process is about to exit, so the event has to land before it does, and a board that is down must not hold the exit up.
url="${CCBOARD_URL:-http://127.0.0.1:8000}"
tokfile="${CCBOARD_HOOK_TOKEN_FILE:-$HOME/.local/share/ccboard/hook-token}"
tok=$(cat "$tokfile" 2>/dev/null) || exit 0
[ -n "$tok" ] || exit 0
curl -s -m 2 -o /dev/null -X POST "$url/api/hook" \
  -H "Content-Type: application/json" \
  -H "X-CCBoard-Token: $tok" \
  -H "X-CCBoard-Agent: ${CCBOARD_AGENT:-claude}" \
  -H "X-CCBoard-Child: ${CLAUDE_CODE_CHILD_SESSION:-}" \
  -H "X-CCBoard-Session: ${CCBOARD_SESSION:-}" \
  -H "X-CCBoard-Pane: ${TMUX_PANE:-}" \
  -H "X-CCBoard-Tmux: ${TMUX:-}" \
  --data-binary @- 2>/dev/null || true
exit 0
